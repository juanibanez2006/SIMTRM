DATABASE_PATH=data/simtrm.sqlite3
SOURCE_TIMEOUT_SECONDS=30
SOURCE_PAGE_SIZE=1000
SOURCE_RETRIES=3
SOURCE_BACKOFF_SECONDS=1
SYNC_LOOKBACK_DAYS=60
AUTO_SYNC_ENABLED=true
AUTO_SYNC_INTERVAL_HOURS=6
# Optional; backend only. Never put these secrets in VITE_* variables.
SOCRATA_APP_TOKEN=
ADMIN_TOKEN=
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
